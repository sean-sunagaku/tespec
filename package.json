{
  "name": "@sean-sunagaku/tespec",
  "version": "0.1.0",
  "description": "CLI for validating YAML-based screen specs and generating Playwright test skeletons.",
  "author": "sean-sunagaku",
  "type": "module",
  "bin": {
    "tespec": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/cli.js",
  "module": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "skill:sync": "tsx scripts/generate-references.ts",
    "skill:install": "tsx scripts/generate-references.ts && rsync -av skills/tespec-yaml-gen/ ~/.claude/skills/tespec-yaml-gen/",
    "lint": "biome lint ./src ./tests",
    "fmt": "biome format --write ./src ./tests",
    "check": "biome check --write ./src ./tests",
    "check:ci": "biome check ./src ./tests",
    "publish:check": "pnpm pack --dry-run",
    "publish:package": "pnpm publish",
    "prepublishOnly": "pnpm test && pnpm run build",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sean-sunagaku/tespec.git"
  },
  "keywords": [
    "cli",
    "yaml",
    "playwright",
    "testing",
    "spec"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sean-sunagaku/tespec/issues"
  },
  "homepage": "https://github.com/sean-sunagaku/tespec#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@oclif/core": "^4.10.2",
    "chokidar": "^4.0.3",
    "hono": "^4.12.9",
    "picocolors": "^1.1.1",
    "preact": "^10.29.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^25.5.0",
    "jsdom": "^29.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "oclif": {
    "bin": "tespec",
    "commands": "./dist/commands"
  }
}
